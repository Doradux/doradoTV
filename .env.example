# Stable 32-byte base64 key. Generate once; keep a backup and never commit its value.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DORADO_ENCRYPTION_KEY=
# Public canonical app URL, with HTTPS in production; a netlify.app URL works.
DORADO_APP_URL=https://your-site.netlify.app
# Google Identity Services web client ID (public). No client secret is needed.
GOOGLE_CLIENT_ID=
# No global relay configuration in Netlify. Each room owner sets their own relay
# URL and secret in DoradoTV. Relay hosting still needs DORADO_RELAY_SECRET.
# Turnstile: authorize the exact app hostname (and localhost for development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Dedicated Gmail account with 2FA and an app password; no ordinary login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Required for public alleged illegal content notices, along with SMTP_USER/PASSWORD.
# Configure an inbox you actively review and respond from; an empty value disables the reporting form.
DORADO_REPORT_EMAIL=
