# Do not reuse your DoradoTV relay secret here. At least 32 random characters.
ADDON_TOKEN=
# Torznab feed from Jackett/Prowlarr (configure the indexers you are authorized to use).
# Example: http://127.0.0.1:9117/api/v2.0/indexers/all/results/torznab/api
TORZNAB_URL=
TORZNAB_API_KEY=
# Bind this service to localhost and publish it via a trusted HTTPS reverse proxy.
PORT=5310
# Optional, only for movies/episodes you are authorized to distribute.
SOURCES_FILE=./config/sources.json
# Only when using compose.full.yaml to launch the relay as well:
DORADO_RELAY_SECRET=
DORADO_APP_ORIGIN=https://doradotv.netlify.app
# Optional; should match the relay HTTPS domain, otherwise inferred from proxy headers.
DORADO_RELAY_PUBLIC_URL=
